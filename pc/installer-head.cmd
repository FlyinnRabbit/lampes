@echo off
title Installing Lamps
set "LAMPES_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0'); $a='#'+'PSSTART'; $b='#'+'PSEND'; $i=$t.IndexOf($a)+$a.Length; iex $t.Substring($i, $t.IndexOf($b)-$i)"
if errorlevel 1 pause
exit /b
#PSSTART
$ErrorActionPreference = 'Stop'
try {
  # La page est incluse a la fin de ce fichier
  $t = [IO.File]::ReadAllText($env:LAMPES_SELF)
  $m = '#' + 'HTML' + 'START'
  $html = $t.Substring($t.IndexOf($m) + $m.Length).TrimStart("`r", "`n")
  if ($html -notmatch 'version __VERSION__') { throw "Installer file damaged: download it again." }

  $app = Join-Path $env:LOCALAPPDATA 'LampesBT'
  New-Item -ItemType Directory -Force $app | Out-Null

  # Ferme les fenetres Lampes proprement (pour que les reglages soient enregistres), puis de force si besoin
  $procs = Get-CimInstance Win32_Process -Filter "Name='chrome.exe' OR Name='msedge.exe'" -ErrorAction SilentlyContinue |
    Where-Object { $_.CommandLine -like '*LampesBT*' }
  if ($procs) {
    # chaque etape tolere qu'un processus Chrome se soit deja arrete entre-temps
    foreach ($pr in $procs) { try { $p = Get-Process -Id $pr.ProcessId -ErrorAction Stop; if ($p.MainWindowHandle -ne 0) { [void]$p.CloseMainWindow() } } catch {} }
    for ($i = 0; $i -lt 20; $i++) {
      $alive = @(); foreach ($pr in $procs) { try { $alive += Get-Process -Id $pr.ProcessId -ErrorAction Stop } catch {} }
      if (!$alive.Count) { break }; Start-Sleep -Milliseconds 250
    }
    foreach ($pr in $procs) { try { Stop-Process -Id $pr.ProcessId -Force -ErrorAction Stop } catch {} }
    Start-Sleep -Milliseconds 500
  }

  # Efface un eventuel refus d'acces au son (micro / Voicemeeter) memorise par l'app
  $pref = Join-Path $app 'profil\Default\Preferences'
  if (Test-Path $pref) {
    try {
      $j = Get-Content $pref -Raw -Encoding UTF8 | ConvertFrom-Json
      $ex = $j.profile.content_settings.exceptions
      $chg = $true
      # blocage automatique de Chrome apres plusieurs fenetres fermees : efface
      if ($ex -and $ex.PSObject.Properties['permission_autoblocking_data']) { $ex.PSObject.Properties.Remove('permission_autoblocking_data') }
      # acces au son (Voicemeeter...) autorise d'office pour la page Lampes : plus de fenetre d'autorisation
      if (-not $j.profile.content_settings) { $j.profile | Add-Member -Force -NotePropertyName content_settings -NotePropertyValue ([pscustomobject]@{}) }
      if (-not $j.profile.content_settings.exceptions) { $j.profile.content_settings | Add-Member -Force -NotePropertyName exceptions -NotePropertyValue ([pscustomobject]@{}) }
      $ex = $j.profile.content_settings.exceptions
      $pageUrl = ([Uri](Join-Path $app 'lampes-bt.html')).AbsoluteUri
      $mic = $ex.media_stream_mic
      if (-not $mic) { $mic = [pscustomobject]@{}; $ex | Add-Member -Force -NotePropertyName media_stream_mic -NotePropertyValue $mic }
      # garde les autorisations deja donnees, efface les refus (setting 2)
      foreach ($pr in @($mic.PSObject.Properties)) { if ($pr.Value.setting -eq 2) { $mic.PSObject.Properties.Remove($pr.Name) } }
      $mic | Add-Member -Force -NotePropertyName ($pageUrl + ',*') -NotePropertyValue ([pscustomobject]@{ setting = 1 })
      if ($chg) {
        [IO.File]::WriteAllText($pref, ($j | ConvertTo-Json -Depth 100 -Compress), (New-Object Text.UTF8Encoding $false))
        Write-Host "  Audio access allowed for Lamps."
      }
    } catch { Write-Host "  (could not reset audio access: $($_.Exception.Message))" }
  }

  $page = Join-Path $app 'lampes-bt.html'
  [IO.File]::WriteAllText($page, $html, (New-Object Text.UTF8Encoding $false))
  $url = ([Uri]$page).AbsoluteUri

  $exe = @(
    "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
    "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
    "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
  ) | Where-Object { Test-Path $_ } | Select-Object -First 1
  if (!$exe) { throw "Neither Chrome nor Edge was found on this PC." }

  $arg = "--app=`"$url`" --user-data-dir=`"$app\profil`" --enable-features=WebBluetoothNewPermissionsBackend --enable-experimental-web-platform-features --no-first-run --no-default-browser-check --disable-application-cache --use-fake-ui-for-media-stream --test-type --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-features=CalculateNativeWinOcclusion,IntensiveWakeUpThrottling --window-size=920,1000"

  $ico = "$exe,0"
  try {
    # icone : le lapin Lampes
    $icoPath = Join-Path $app 'lapin.ico'
    [IO.File]::WriteAllBytes($icoPath, [Convert]::FromBase64String(''))
    $ico = "$icoPath,0"
  } catch {}

  $ws = New-Object -ComObject WScript.Shell
  foreach ($dir in @([Environment]::GetFolderPath('Desktop'), (Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs'))) {
    Remove-Item (Join-Path $dir 'Lampes.lnk') -ErrorAction SilentlyContinue
    $l = $ws.CreateShortcut((Join-Path $dir 'Lamps.lnk'))
    $l.TargetPath = $exe; $l.Arguments = $arg; $l.IconLocation = $ico
    $l.WorkingDirectory = $app; $l.Description = 'Bluetooth Lamps'; $l.Save()
  }

  Write-Host ""
  Write-Host "  Lamps version __VERSION__ installed (Desktop + Start menu). Opening..." -ForegroundColor Green
  Start-Process $exe $arg
  Start-Sleep 2
} catch {
  Write-Host ""
  Write-Host "  Error: $($_.Exception.Message)" -ForegroundColor Red
  exit 1
}
#PSEND
#HTMLSTART
